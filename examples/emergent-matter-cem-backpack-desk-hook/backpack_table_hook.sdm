{
  "schema_version": "0.2",
  "name": "backpack_table_hook",
  "metadata": {
    "units": "mm",
    "description": "Clamp-on C hook: tapered top bar on the table, spine down the edge, jaw under the table looping back into a front-loading handle hook",
    "frame": "profile in XY as printed; +X away from table, +Y up installed, z = width on bed",
    "process": "FDM, Prusa Core One, Prusament PLA, printed on its side",
    "param_meanings": {
      "d_table_thickness": "Measured table-top thickness",
      "d_table_clearance": "Slip-fit gap added to the table thickness",
      "d_width": "Width along the table edge (print height)",
      "d_wall": "Section thickness of the bent bar; also the top-bar root",
      "d_top_tip": "Top-bar thickness at its inner tip",
      "d_top_length": "Top-bar reach onto the table from the edge",
      "d_jaw_depth": "Jaw reach under the table, to the loop-back",
      "d_throat": "Inside height of the hook for the handle",
      "d_lip_height": "Lip rise above the lower leg (retains the handle)",
      "d_lip_setback": "Lip outer face distance behind the table edge",
      "d_edge_radius": "Rounding on the side-face edges and convex corners",
      "d_fillet_table": "Inside bend radius at the two corners that hug the table",
      "d_fillet_hook": "Inside bend radius where the lip rises from the leg"
    }
  },
  "params": {
    "d_table_thickness": {
      "name": "d_table_thickness",
      "value": 25.4,
